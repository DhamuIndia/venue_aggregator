COMPOSE_PROJECT_NAME=bookvenuemart-preprod

APP_DOMAIN=preprod.bookvenuemart.in
API_DOMAIN=api-preprod.bookvenuemart.in
MEDIA_DOMAIN=media-preprod.bookvenuemart.in

NEXT_PUBLIC_API_BASE_URL=https://api-preprod.bookvenuemart.in/api/v1

# These credentials create a logically isolated database inside the existing
# PostgreSQL container. Never reuse the production database name or user.
PREPROD_POSTGRES_DB=venue_aggregator_preprod
PREPROD_POSTGRES_USER=venue_preprod_app
PREPROD_POSTGRES_PASSWORD=replace-with-strong-preprod-postgres-password

# This access key is restricted to the dedicated preprod bucket by the
# bootstrap script. The bucket name is intentionally fixed to match the policy.
PREPROD_MINIO_ACCESS_KEY=venue_preprod_minio
PREPROD_MINIO_SECRET_KEY=replace-with-strong-preprod-minio-password
PREPROD_MINIO_BUCKET=venue-media-preprod

PREPROD_JWT_SECRET=replace-with-a-different-64-plus-character-random-secret
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000
CORS_ALLOWED_ORIGINS=https://preprod.bookvenuemart.in

MEDIA_MAX_UPLOAD_SIZE_BYTES=10485760
MARKETPLACE_REQUIREMENTS_ENABLED=false

# Preprod can never send or accept WhatsApp events. The compose file also
# hard-codes both switches to false and does not accept Meta credentials.
WHATSAPP_SENDING_ENABLED=false
WHATSAPP_WEBHOOK_ENABLED=false

# The shared Caddy container must also join `bookvenuemart_preprod_internal`.

preprod.bookvenuemart.in {
  encode gzip zstd

  request_body {
    max_size 25MB
  }

  reverse_proxy bookvenuemart-preprod-frontend:3000

  header {
    Referrer-Policy same-origin
    X-Content-Type-Options nosniff
    X-Frame-Options SAMEORIGIN
    X-Robots-Tag "noindex, nofollow, noarchive"
  }
}

api-preprod.bookvenuemart.in {
  encode gzip zstd

  request_body {
    max_size 25MB
  }

  reverse_proxy bookvenuemart-preprod-backend:8080

  header {
    Referrer-Policy same-origin
    X-Content-Type-Options nosniff
    X-Frame-Options SAMEORIGIN
    X-Robots-Tag "noindex, nofollow, noarchive"
  }
}

media-preprod.bookvenuemart.in {
  encode gzip zstd

  request_body {
    max_size 25MB
  }

  header {
    Referrer-Policy same-origin
    X-Content-Type-Options nosniff
    X-Robots-Tag "noindex, nofollow, noarchive"
  }

  reverse_proxy bookvenuemart-minio:9000
}
